    given-names: "Karina"
    email: "correak096@gmail.com"
repository-code: "https://github.com/KARCOR"
license: MIT
date-released: "2026-07-27"
keywords:
  - bioinformática
  - microbioma
  - amplicón ITS
  - DADA2
  - análisis de datos
  - ciencia de datos
  - reproducibilidad
